{
  "name": "finance-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,wrangler -c blue,yellow \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "vite",
    "dev:backend": "wrangler pages dev public --port=8788",
    "build": "vite build",
    "icons": "bash scripts/generate-icons.sh",
    "deploy": "npm run build && wrangler pages deploy dist",
    "db:create": "wrangler d1 create finance-db",
    "db:migrate": "wrangler d1 execute finance-db --remote --file=schema.sql",
    "db:migrate:local": "wrangler d1 execute finance-db --file=schema.sql",
    "db:seed": "wrangler d1 execute finance-db --remote --file=seed.sql",
    "db:seed:local": "wrangler d1 execute finance-db --file=seed.sql"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "vite": "^5.4.0",
    "wrangler": "^3.80.0"
  }
}
