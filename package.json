{
  "name": "finance-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,wrangler -c blue,yellow \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "vite",
    "dev:backend": "wrangler pages dev public --port=8788",
    "build": "vite build",
    "icons": "bash scripts/generate-icons.sh",
    "deploy": "npm run build && wrangler pages deploy dist",
    "setup": "bash scripts/setup.sh",
    "db:migrate": "bash scripts/db.sh migrate",
    "db:migrate:remote": "bash scripts/db.sh migrate:remote",
    "worker:dev": "wrangler dev --config worker/wrangler.toml --persist-to .wrangler/state --test-scheduled",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "db:seed": "bash scripts/db.sh seed"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "vite": "^5.4.0",
    "wrangler": "^4.94.0"
  }
}
